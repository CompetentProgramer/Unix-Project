[Unit]
Description=Custom Linux observability agent
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=obs-agent
Group=obs-agent
WorkingDirectory=/opt/obs-agent/agent
EnvironmentFile=/etc/obs-agent/agent.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/obs-agent/agent/run_agent.sh

RuntimeDirectory=obs-agent
RuntimeDirectoryMode=0750
UMask=0007

Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/obs-agent

[Install]
WantedBy=multi-user.target
